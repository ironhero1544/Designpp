//Microsoft Visual C++에서 생성한 리소스 스크립트입니다.
//
#include "Resource.h"

#define APSTUDIO_READONLY_SYMBOLS
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE 리소스에서 생성되었습니다.
//
#ifndef APSTUDIO_INVOKED
#include "targetver.h"
#endif
#define APSTUDIO_HIDDEN_SYMBOLS
#include "windows.h"
#undef APSTUDIO_HIDDEN_SYMBOLS
/////////////////////////////////////////////////////////////////////////////
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_KOR)
LANGUAGE 18, 1

/////////////////////////////////////////////////////////////////////////////
//
// 아이콘
//

// 애플리케이션 아이콘이 모든 시스템에서 일관된 상태로 유지되도록
// 가장 낮은 ID 값을 가진 아이콘이 맨 처음 배치됩니다.

IDI_DESIGN       ICON         "Design++.ico"
IDI_SMALL               ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// 메뉴
//

IDC_DESIGN MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "새 Library...",            IDM_NEW_LIBRARY
        MENUITEM "Library Root 설정...",     IDM_LIBRARY_ROOT
        MENUITEM "새로 고침",                 IDM_LIBRARY_REFRESH
        POPUP "최근 Workspace"
        BEGIN
            MENUITEM "(없음)",                 IDM_RECENT_EMPTY, GRAYED
        END
        MENUITEM SEPARATOR
        MENUITEM "끝내기(&X)",                IDM_EXIT
    END
    POPUP "편집(&E)"
    BEGIN
        MENUITEM "새 Cell...",               IDM_NEW_CELL
        MENUITEM "새 View...",               IDM_NEW_VIEW
        MENUITEM "파일 가져오기...",          IDM_IMPORT_FILES
        MENUITEM "Liberty 파일 관리...",      IDM_MANAGE_LIBERTY
        MENUITEM SEPARATOR
        MENUITEM "속성...",                   IDM_LIBRARY_PROPERTIES
        MENUITEM "삭제",                      IDM_LIBRARY_DELETE
    END
    POPUP "도구(&T)"
    BEGIN
        MENUITEM "Tool Check...",             IDM_TOOL_CHECK
        MENUITEM "Toolchain Doctor...",       IDM_TOOLCHAIN_DOCTOR
        MENUITEM SEPARATOR
        MENUITEM "WSL2 Setup...",             IDM_WSL_SETUP
        MENUITEM "Install / Update Toolchain...", IDM_INSTALL_BASE_TOOLS
        MENUITEM SEPARATOR
        MENUITEM "Cancel Operation",          IDM_CANCEL_OPERATION, GRAYED
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "정보(&A)...",           IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// 액셀러레이터 키
//

IDC_DESIGN ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// 대화 상자
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "정보 Design++"
FONT 9, "MS Shell Dlg"
BEGIN
    ICON            IDI_DESIGN,IDC_STATIC,14,14,21,20
    LTEXT           "Design++, 버전 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "확인",IDOK,113,41,50,14,WS_GROUP
END

IDD_LIBRARY_ITEM DIALOGEX 0, 0, 285, 142
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Library 항목"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "이름",IDC_STATIC,10,12,48,10
    EDITTEXT        IDC_ITEM_NAME,62,10,210,14,ES_AUTOHSCROLL
    LTEXT           "종류",IDC_STATIC,10,36,48,10
    COMBOBOX        IDC_VIEW_KIND,62,34,210,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "설명",IDC_STATIC,10,60,48,10
    EDITTEXT        IDC_ITEM_DESCRIPTION,62,58,210,48,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "확인",IDOK,166,118,50,14
    PUSHBUTTON      "취소",IDCANCEL,222,118,50,14
END

/////////////////////////////////////////////////////////////////////////////
//
// DESIGNINFO
//

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_ABOUTBOX, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 163
        TOPMARGIN, 7
        BOTTOMMARGIN, 55
    END
END
#endif    // APSTUDIO_INVOKED

#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//
1 TEXTINCLUDE
BEGIN
    "Resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#ifndef APSTUDIO_INVOKED\r\n"
    "#include ""targetver.h""\r\n"
    "#endif\r\n"
    "#define APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "#include ""windows.h""\r\n"
    "#undef APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END

#endif    // APSTUDIO_INVOKED

/////////////////////////////////////////////////////////////////////////////
//
// 문자열 테이블
//

STRINGTABLE
BEGIN
   IDC_DESIGN   "DESIGN"
   IDS_APP_TITLE       "Design++"
END

#endif
